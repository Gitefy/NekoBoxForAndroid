+				metadata.Inet4Current = address
+			} else if address.Is6() && (!metadata.Inet6Current.IsValid() || address.Compare(metadata.Inet6Current) > 0) {
+				metadata.Inet6Current = address
+			}
+		}
+		if !metadata.Inet4Current.IsValid() && !metadata.Inet6Current.IsValid() {
 			return os.ErrInvalid
 		}
-		return metadata.UnmarshalBinary(metadataBinary)
+		return nil
 	})
