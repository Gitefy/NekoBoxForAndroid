@@ -0,0 +1,50 @@
+package trafficcontrol
+
+import (
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/gofrs/uuid/v5"
+)
+
+type snapshotTracker struct{ metadata TrackerMetadata }
+
+func (t *snapshotTracker) Metadata() *TrackerMetadata { return &t.metadata }
+func (t *snapshotTracker) Close() error               { return nil }
+func TestEgoXClosedSnapshotDoesNotMutateActiveMetadata(t *testing.T) {
+	m := NewManager()
+	tracker := &snapshotTracker{metadata: TrackerMetadata{ID: uuid.Must(uuid.NewV4()), Upload: new(atomic.Int64), Download: new(atomic.Int64)}}
+	m.join(tracker)
+	snapshot := m.Connections()[0]
+	done := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for {
+			select {
+			case <-done:
+				return
+			default:
+			}
+			_ = snapshot.ClosedAt.IsZero()
+			runtime.Gosched()
+		}
+	}()
+	m.leave(tracker)
+	close(done)
+	wg.Wait()
+	if !snapshot.ClosedAt.IsZero() {
+		t.Fatal("closing a connection changed previously published metadata")
+	}
+	closed := m.ClosedConnections()
+	if len(closed) != 1 || closed[0].ClosedAt.IsZero() {
+		t.Fatal("closed snapshot lacks its closure timestamp")
+	}
+	m.leave(tracker)
+	if len(m.ClosedConnections()) != 1 {
+		t.Fatal("duplicate close created another history entry")
+	}
+}
