+++ b/route/udp_sniff_packet_test.go
@@ -0,0 +1,47 @@
+package route
+
+import (
+	"bytes"
+	"context"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/sniff"
+	"github.com/sagernet/sing-box/log"
+	R "github.com/sagernet/sing-box/route/rule"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type udpSniffDatagram struct {
+	N.PacketConn
+	payload []byte
+}
+
+func (c *udpSniffDatagram) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	_, err := buffer.Write(c.payload)
+	return M.ParseSocksaddr("127.0.0.1:4444"), err
+}
+
+func (*udpSniffDatagram) SetReadDeadline(time.Time) error { return nil }
+
+func TestUDPSniffPreservesFullDatagram(t *testing.T) {
+	for _, size := range []int{16384, 65507} {
+		payload := bytes.Repeat([]byte{0x5a}, size)
+		r := &Router{logger: log.NewNOPFactory().NewLogger("test")}
+		metadata := &adapter.InboundContext{Network: N.NetworkUDP, Destination: M.ParseSocksaddr("127.0.0.1:4444")}
+		action := &R.RuleActionSniff{PacketSniffers: []sniff.PacketSniffer{sniff.DomainNameQuery}}
+		_, packets, err := r.actionSniff(context.Background(), metadata, action, nil, &udpSniffDatagram{payload: payload}, nil, nil)
+		if err != nil || len(packets) != 1 {
+			t.Fatalf("sniff cached packet: count %d, error %v", len(packets), err)
+		}
+		got := packets[0].Buffer.Len()
+		equal := bytes.Equal(packets[0].Buffer.Bytes(), payload)
+		N.ReleaseMultiPacketBuffer(packets)
+		if !equal {
+			t.Fatalf("sniff truncated packet: got %d bytes, want %d", got, size)
+		}
+	}
+}
